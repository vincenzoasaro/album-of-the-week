---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Story from './Story.astro';
import Quiz from './Quiz.astro';
import Archive from './Archive.astro';
import Newsletter from './Newsletter.astro';
import Footer from './Footer.astro';
import ListeningMode from './ListeningMode.astro';
import ShareDialog from './ShareDialog.astro';
import { sidesOf } from '../lib/albums';
import site from '../data/site.json';
import { useTranslations } from '../i18n/ui';
import { amazonEmbedUrl, appleEmbedUrl, inkOn, toSeconds, url, youtubeIds, type Album } from '../lib/albums';
import { controllable, type Source } from '../scripts/player';

interface Props {
  album: Album;
  archive: Album[];
  isCurrent: boolean;
  alternateUrl: string;
}
const { album, archive, isCurrent, alternateUrl } = Astro.props;
const lang = album.lang;
const t = useTranslations(lang);

const yt = youtubeIds(album.youtubePlaylistId, album.youtubeVideoId);
const sources: Source[] = [];
if (yt.playlistId || yt.videoId) sources.push('youtube');
if (album.spotifyAlbumId) sources.push('spotify');
// A service is only shown when the album has a valid link for it.
const apple = appleEmbedUrl(album.appleMusicUrl);
const amazon = amazonEmbedUrl(album.amazonMusicEmbed);
if (apple) sources.push('apple');
if (amazon) sources.push('amazon');
if (album.appleMusicUrl && !apple) console.warn(`[${album.slug}] The Apple Music link isn't a music.apple.com link, so Apple Music is hidden.`);
if (album.amazonMusicEmbed && !amazon) console.warn(`[${album.slug}] The Amazon Music field needs the embed code from Share > Embed, so Amazon Music is hidden.`);
const canControl = sources.some(controllable);
const multiSide = sidesOf(album).length > 1;

const pageData = {
  player: {
    youtubePlaylistId: yt.playlistId,
    youtubeVideoId: yt.videoId,
    spotifyAlbumId: album.spotifyAlbumId,
    appleEmbedUrl: apple,
    amazonEmbedUrl: amazon,
    trackStarts: album.tracks.map((tr) => toSeconds(tr.ytStart)),
  },
  sources,
  tracks: album.tracks.map((tr) => ({ side: tr.side || 'A', title: tr.title, time: tr.time, note: tr.note })),
  labels: { play: t('hero.play'), pause: t('hero.pause'), side: t('tracks.side'), ytError: t('player.ytError'), ytOpen: t('player.ytOpen') },
  card: {
    slug: album.slug,
    title: album.title,
    artist: album.artist,
    year: album.year,
    issue: album.issue,
    accent: album.accent,
    onAccent: inkOn(album.accent),
    siteName: site.siteName,
    cover: album.cover ? url(album.cover) : '',
    quote: album.cardQuote || album.tagline,
    tracks: album.tracks.map((tr, i) => {
      const side = tr.side || 'A';
      const n = multiSide ? `${side}${album.tracks.slice(0, i + 1).filter((x) => (x.side || 'A') === side).length}` : String(i + 1);
      return { n, title: tr.title, time: tr.time };
    }),
    customCards: album.shareCards.filter((c) => c.image).map((c) => ({ label: c.label, url: url(c.image) })),
    labels: { kicker: t('share.kicker'), issue: t('hero.issue'), liner: t('share.liner'), score: t('share.score'), yourTurn: t('share.yourTurn') },
  },
  cardStyles: [
    { id: 'vinyl', label: t('share.styleVinyl') },
    { id: 'sleeve', label: t('share.styleSleeve') },
    { id: 'liner', label: t('share.styleLiner') },
  ],
};
const title = isCurrent
  ? `${album.title} · ${album.artist} | ${site.siteName}`
  : `${album.title} · ${album.artist} (Nº ${album.issue}) | ${site.siteName}`;
---
<Base lang={lang} title={title} description={album.tagline || undefined} accent={album.accent} alternateUrl={alternateUrl} ogImage={album.cover ? url(album.cover) : undefined}>
  <Header lang={lang} alternateUrl={alternateUrl} />
  <main id="top">
    <Hero album={album} isCurrent={isCurrent} sources={sources} />
    <Story album={album} canPlay={canControl} />
    <Quiz album={album} />
    <Archive lang={lang} albums={archive} />
    <Newsletter lang={lang} />
  </main>
  <Footer lang={lang} />
  <ListeningMode album={album} canPlay={canControl} />
  <ShareDialog album={album} />
  <script id="page-data" type="application/json" set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  import '../scripts/album-page';
  import '../scripts/reveal';
</script>
