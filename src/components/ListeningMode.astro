---
import Turntable from './Turntable.astro';
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/ui';
import type { Album } from '../lib/albums';
interface Props { album: Album; canPlay: boolean }
const { album, canPlay } = Astro.props;
const t = useTranslations(album.lang);
const first = album.tracks[0];
---
<div class="listening" data-listening hidden role="dialog" aria-modal="true" aria-labelledby="listen-title">
  <div class="listening-top">
    <p class="mono muted" style="margin:0" id="listen-title">{t('listen.title')} · {album.title} · {album.artist}</p>
    <button class="pill" type="button" data-action="close-listening">{t('listen.exit')} ✕</button>
  </div>
  <div class="listening-body">
    <Turntable sideWord={t('tracks.side')} title={album.title} artist={album.artist} side={first?.side || 'A'} variant="focus" />
    {first && (
      <div class="listening-info" aria-live="polite">
        <p class="mono accent" style="margin:0">{t('listen.now')} · <span data-listen="n">1</span> / {album.tracks.length}</p>
        <h2 class="listening-title" data-listen="title">{first.title}</h2>
        <p class="listening-note" data-listen="note">{first.note}</p>
        <p class="mono muted" style="margin:0" data-listen="time">{first.time}</p>
        <div class="listening-controls">
          <button class="round" type="button" data-action="prev" aria-label={t('listen.prev')}><Icon name="prev" /></button>
          {canPlay && (
            <button class="round round--big" type="button" data-action="toggle-play" aria-pressed="false" aria-label={t('hero.play')}>
              <Icon name="play" size={22} fill="var(--on-accent)" /><Icon name="pause" size={22} fill="var(--on-accent)" hidden />
            </button>
          )}
          <button class="round" type="button" data-action="next" aria-label={t('listen.next')}><Icon name="next" /></button>
        </div>
      </div>
    )}
  </div>
  <p class="mono muted listening-hint">{t('listen.hint')}</p>
</div>
