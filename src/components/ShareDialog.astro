---
import { useTranslations } from '../i18n/ui';
import type { Album } from '../lib/albums';
interface Props { album: Album }
const { album } = Astro.props;
const t = useTranslations(album.lang);
---
<div class="share-dialog" data-share-dialog hidden role="dialog" aria-modal="true" aria-labelledby="share-title">
  <div class="share-panel">
    <div class="share-top">
      <h2 id="share-title">{t('share.title')}</h2>
      <button class="pill" type="button" data-action="close-share">{t('share.close')} ✕</button>
    </div>
    <p class="mono muted share-hint" style="margin:0">{t('share.swipe')}</p>
    <!-- One slide per card (built-in styles plus any uploaded in the editor), each with its own buttons.
         Filled in by the page script. Swipe sideways on phones. -->
    <div class="share-track" data-share-options role="list"></div>
    <div class="share-dots" data-share-dots aria-hidden="true"></div>
    <label class="share-score" data-share-score hidden>
      <input type="checkbox" checked data-share-include-score />
      <span>{t('share.includeScore')}</span>
    </label>
    <template data-share-labels data-share={t('share.share')} data-download={t('share.download')}></template>
  </div>
</div>
