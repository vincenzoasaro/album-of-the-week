---
import { useTranslations } from '../i18n/ui';
import type { Album } from '../lib/albums';
interface Props { album: Album }
const { album } = Astro.props;
const t = useTranslations(album.lang);
---
<div class="share-dialog" data-share-dialog hidden role="dialog" aria-modal="true" aria-labelledby="share-title">
  <div class="share-panel">
    <div class="share-top">
      <h2 id="share-title">{t('share.title')}</h2>
      <button class="pill" type="button" data-action="close-share">{t('share.close')} ✕</button>
    </div>
    <p class="mono muted" style="margin:0">{t('share.choose')}</p>
    <div class="share-options" role="group" aria-label={t('share.choose')} data-share-options>
      <!-- Filled in by the page script: one button per card style, plus any cards uploaded in the editor. -->
    </div>
    <label class="share-score" data-share-score hidden>
      <input type="checkbox" checked data-share-include-score />
      <span>{t('share.includeScore')}</span>
    </label>
    <div class="share-actions">
      <button class="btn btn--primary" type="button" data-action="do-share" hidden>{t('share.share')}</button>
      <button class="btn" type="button" data-action="do-download">{t('share.download')}</button>
    </div>
  </div>
</div>
