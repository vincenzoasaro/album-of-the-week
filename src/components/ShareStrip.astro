---
import { useTranslations } from '../i18n/ui';
import type { Album } from '../lib/albums';
interface Props { album: Album }
const { album } = Astro.props;
const t = useTranslations(album.lang);
---
<!-- "Take it with you": the share cards, always visible and swipeable, right after the quiz.
     The cards themselves are drawn by the page script (src/scripts/share-ui.ts). -->
<section id="cards" class="wrap share-strip" data-share-strip aria-labelledby="cards-title">
  <div class="strip-head">
    <div class="strip-copy">
      <h2 class="section-title" id="cards-title">{t('strip.title')}</h2>
      <p class="strip-lede">{t('strip.lede')}</p>
    </div>
    <div class="strip-controls">
      <label class="share-score" data-strip-score hidden>
        <input type="checkbox" checked data-strip-include-score />
        <span>{t('share.includeScore')}</span>
      </label>
      <div class="strip-arrows">
        <button class="strip-arrow" type="button" data-strip="prev" aria-label={t('strip.prev')}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3 L5 9 L11 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button class="strip-arrow" type="button" data-strip="next" aria-label={t('strip.next')}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 3 L13 9 L7 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="strip-track" data-strip-track role="list" aria-label={t('strip.title')}></div>
  <div class="share-dots strip-dots" data-strip-dots aria-hidden="true"></div>
</section>
