---
import AlbumPage from '../components/AlbumPage.astro';
import EmptyState from '../components/EmptyState.astro';
import { getCurrentAndArchive, homeUrl } from '../lib/albums';

const { current, archive } = await getCurrentAndArchive('en');
---
{current
  ? <AlbumPage album={current} archive={archive} isCurrent alternateUrl={homeUrl('it')} />
  : <EmptyState lang="en" />}
